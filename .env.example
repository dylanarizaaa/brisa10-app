# Conexión a Supabase. Son los mismos valores de la app administrativa (su archivo .env),
# con otro prefijo. Copia este archivo como .env.local y complétalo.
# Nunca pongas aquí la clave service_role: todo lo que empieza por EXPO_PUBLIC_ queda dentro de la app.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica
